{
  // Cloudflare Workers config for GEARS. Deploy with: npx wrangler deploy
  "name": "gears-sim",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only the two server routes run the Worker; everything else is a static file.
    "run_worker_first": ["/.netlify/functions/*"]
  },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create GEARS_STATE, then paste the id here.
    { "binding": "GEARS_STATE", "id": "17fdce14b4494756bb93bb8da663ec1c" }
  ]
}
